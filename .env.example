# Application Setup
PORT=3000
NODE_ENV=development
DEFAULT_TIER=free

# Redis Setup (Upstash REST)
# Replace with your actual Upstash REST URL and Token
UPSTASH_REDIS_REST_URL=https://endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here
REDIS_URL=rediss://default:your_redis_token_here@endpoint.upstash.io:6379